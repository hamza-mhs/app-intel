META_TOKEN=
META_COUNTRIES=DE,FR,GB,NL,IT,ES,SE,PL
META_API_VERSION=v25.0
IG_USER_ID=
IG_TOKEN=
TRUSTMRR_API_KEY=
# Daily category crawl
CRAWL_COUNTRIES=us
CRAWL_STORES=ios,android
# Expansion after charts: keyword searches, developers, similar apps (0 to disable)
CRAWL_EXPAND=1
EXPAND_MIN_RATINGS=20
PORT=4317
# SaaS mode: live catalog sync (Shopify App Store, WordPress, Atlassian, TrustMRR, Show HN, Product Hunt)
SAAS_SYNC=1
# Free Product Hunt developer token: producthunt.com/v2/oauth/applications
PH_TOKEN=

# SaaS: minimum active installs for a WordPress plugin to be listed (default 2000 ≈ 5,000 plugins)
WP_MIN_INSTALLS=2000

# SaaS sources to show and sync. Default: general SaaS only.
# Add shopify and/or wp to include Shopify apps and WordPress plugins (platform add-ons).
SAAS_SOURCES=research,zap,yc,trustmrr,hn,ph,atl
